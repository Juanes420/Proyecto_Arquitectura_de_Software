flowchart LR
    U["Usuario<br/>(navegador)"]
    ADM["Administrador<br/>(CLI / servidor)"]
    E2["Equipo 2<br/>Tienda de Carnicería<br/>(consume nuestra API)"]
    ALI["Tienda de muebles y decoración<br/>API JSON del equipo aliado"]
    FTG["FreeToGame.com<br/>API de terceros<br/>juegos gratis"]
    STEAM["Steam Store<br/>API de terceros<br/>appdetails + portadas"]
    CRON["cron-job.org<br/>ping a /up cada 10 min"]

    subgraph RENDER["Render · contenedor Docker (nginx + PHP-FPM)"]
        direction TB
        subgraph RUTAS["Rutas"]
            WEB["routes/web.php"]
            API["routes/api.php<br/>GET /api/videojuegos"]
        end
        subgraph CTRL["Controladores"]
            C0["HomeController"]
            C1["VideoJuegoController<br/>PedidoController<br/>WishlistController…"]
            C2["Api · VideoJuegoApiController"]
            C3["JuegosGratisController"]
            C4["ProductosAliadosController"]
        end
        CMD["Comando Artisan<br/>juegos:importar-steam"]
        subgraph SERV["Servicios"]
            S1["PedidoService"]
            S2["FreeToGameService"]
            S5["SteamService"]
            S6["PortadaService"]
            I1[["«interface»<br/>ProductosAliadosService"]]
            S3["ProductosAliadosApi"]
            S4["ProductosAliadosLocal"]
        end
        subgraph MOD["Modelos Eloquent"]
            M["VideoJuego · Categoria · Pedido<br/>DetallePedido · Tarjeta · Reseña…"]
        end
        R["VideoJuegoResource<br/>(formato JSON)"]
        V["Vistas Blade<br/>lang/es · lang/en"]
    end

    DB[("TiDB Cloud Starter<br/>MySQL compatible · TLS")]

    U -- HTTPS --> WEB
    E2 -- "GET /api/videojuegos" --> API
    CRON -- "GET /up" --> RENDER
    ADM -- "php artisan" --> CMD
    WEB --> C0 & C1 & C3 & C4
    API --> C2
    C0 --> S6
    C1 --> S1
    C1 --> M
    S1 --> M
    S6 --> M
    C2 --> M
    C2 --> R
    C3 --> S2
    C4 --> I1
    CMD --> S5
    CMD --> M
    S3 -. implementa .-> I1
    S4 -. implementa .-> I1
    S2 -- "HTTP GET /api/games" --> FTG
    S5 -- "HTTP GET /api/appdetails" --> STEAM
    S3 -- "HTTP GET (ALIADOS_API_URL)" --> ALI
    M --> DB
    C0 & C1 & C3 & C4 --> V
