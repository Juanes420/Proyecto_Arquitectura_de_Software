classDiagram
    direction LR

    class ProductosAliadosService {
        <<interface>>
        +obtener() array
        +origen() string
    }
    class ProductosAliadosApi {
        -string url
        +obtener() array
        +origen() string
        -consultar() array
        -normalizar(array item) array
    }
    class ProductosAliadosLocal {
        +obtener() array
        +origen() string
    }
    class ProductosAliadosController {
        +index(ProductosAliadosService aliados) View
    }
    class FreeToGameService {
        +populares(int limite) array
        -consultar() array
    }
    class JuegosGratisController {
        +index(FreeToGameService freeToGame) View
    }
    class PedidoService {
        +crear(int usuarioId, array videojuegos, array tarjetas, array dlcs) Pedido
        +cancelar(Pedido pedido) bool
        -verificar(Model producto, int cantidad, string nombre, bool conStock) void
    }
    class CarritoService {
        +agregar(string tipo, int id, int cantidad) void
        +actualizar(string tipo, int id, int cantidad) void
        +quitar(string tipo, int id) void
        +vaciar() void
        +items() Collection
        +total() float
        +porTipo() array
        +tieneAgotados() bool
    }
    class CarritoController {
        -CarritoService carrito
        +index() View
        +agregar(CarritoRequest request) RedirectResponse
        +comprar(CarritoRequest request) RedirectResponse
        +actualizar(CarritoRequest request) RedirectResponse
        +quitar(CarritoRequest request) RedirectResponse
    }
    class PedidoController {
        -PedidoService pedidos
        -CarritoService carrito
        +index() View
        +create() View
        +store() RedirectResponse
        +show(Pedido pedido) View
        +cancelar(Pedido pedido) RedirectResponse
    }
    class SteamService {
        +detalles(int appId) array
        +appIdDesdeImagen(string imagen) int
    }
    class PortadaService {
        +diapositivas() array
    }
    class VideoJuegoApiController {
        +index() AnonymousResourceCollection
    }
    class VideoJuegoResource {
        +toArray(Request request) array
    }
    class VideoJuego {
        +string titulo
        +string plataforma
        +decimal precio
        +int stock
        +scopeEnStock(Builder query) Builder
    }
    class Categoria {
        +string nombre
    }
    class Pedido {
        +datetime fecha
        +string estado
        +decimal total
        +scopeDelUsuario(Builder query, int usuarioId) Builder
        +perteneceA(int usuarioId) bool
    }
    class DetallePedido {
        +int cantidad
        +decimal precio_unit
    }
    class Dlc {
        +string nombre
        +decimal precio
        +string imagen
    }
    class Tarjeta {
        +string nombre
        +string plataforma
        +decimal precio
        +int stock
        +scopeEnStock(Builder query) Builder
    }
    class User {
        +string nombre
        +string email
        +string role
    }
    class Resena {
        +int calificacion
        +string comentario
    }

    ProductosAliadosApi ..|> ProductosAliadosService
    ProductosAliadosLocal ..|> ProductosAliadosService
    ProductosAliadosController --> ProductosAliadosService
    JuegosGratisController --> FreeToGameService
    PedidoController --> PedidoService
    PedidoController --> CarritoService
    CarritoController --> CarritoService
    CarritoService --> VideoJuego
    CarritoService --> Tarjeta
    CarritoService --> Dlc
    PedidoService --> Pedido
    PedidoService --> VideoJuego
    PedidoService --> Tarjeta
    PedidoService --> Dlc
    PortadaService --> VideoJuego
    SteamService ..> VideoJuego : importa
    SteamService ..> Dlc : importa
    VideoJuegoApiController --> VideoJuego
    VideoJuegoApiController --> VideoJuegoResource
    Categoria "1" --> "*" VideoJuego
    User "1" --> "*" Pedido
    Pedido "1" --> "*" DetallePedido
    DetallePedido "*" --> "0..1" VideoJuego
    DetallePedido "*" --> "0..1" Tarjeta
    DetallePedido "*" --> "0..1" Dlc
    VideoJuego "1" --> "*" Dlc
    VideoJuego "1" --> "*" Resena
    User "1" --> "*" Resena
