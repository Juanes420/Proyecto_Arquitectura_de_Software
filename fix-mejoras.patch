     public function destroy(Tarjeta $tarjeta)
     {
+        if ($tarjeta->detallePedidos()->exists()) {
+            return redirect()->route('admin.tarjetas.index')
+                ->with('error', __('messages.tarjeta_has_pedidos'));
+        }
